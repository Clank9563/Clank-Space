---
import Base from '../../layouts/Base.astro';
import EntryList from '../../components/EntryList.astro';
import { getEntry } from 'astro:content';
import { formatDate, langParams, t, url, type Lang } from '../../i18n';
import { getPosts, getProjects, lastRevised } from '../../lib/content';
import { site } from '../../site.config';

export function getStaticPaths() { return langParams(); }
const { lang } = Astro.props as { lang: Lang };

const posts = await getPosts(lang);
const projects = (await getProjects(lang)).slice(0, 3);
const now = await getEntry('pages', `${lang}/now`);
const nowFirst = now?.body?.split('\n').find((l) => l.trim() && !/^[#>|]/.test(l))?.replace(/^[-*]\s*/, '') ?? '';
const latestRevision = posts.reduce<Date | undefined>((d, p) => {
  const r = lastRevised(p);
  return !d || r > d ? r : d;
}, undefined);

const copy = {
  zh: {
    before: '有些專案',
    struck: '順利完賽',
    rest: '中途退賽，',
    after: '這裡記下每一次為什麼。',
    lede: `我是 ${site.name.zh}，擔任${site.role.zh}。踩過的坑、繞過的路，最後怎麼解決的，都寫在這裡。`,
    read: '翻開文章',
    about: '認識我',
  },
  en: {
    before: 'Some projects',
    struck: 'made it',
    rest: "didn't finish.",
    after: "Here's why, every time.",
    lede: `I'm ${site.name.en}, a ${site.role.en.toLowerCase()}. The pitfalls, the detours, and how things finally got solved are all written down here.`,
    read: 'Open the entries',
    about: 'About me',
  },
}[lang];
---
<Base lang={lang} description={copy.lede} pageNo="p.001" section="home" altHref={url(lang === 'zh' ? 'en' : 'zh')} lastRevised={latestRevision}>
  <p class="entry-date">
    {latestRevision && <time datetime={latestRevision.toISOString()}>{formatDate(latestRevision, lang)}</time>}
    {site.placeholder && <span class="sample-tag">{t(lang, 'sample')}</span>}
  </p>
  <h1 class="hero-title">
    {copy.before}{lang === 'en' && ' '}<s>{copy.struck}</s><ins>{lang === 'en' && ' '}<span class="nowrap">{copy.rest}</span></ins><br />{copy.after}
  </h1>
  <p class="hero-lede">{copy.lede}</p>
  <div class="btn-row">
    <a class="btn primary" href={url(lang, 'posts/')}>{copy.read}</a>
    <a class="btn" href={url(lang, 'about/')}>{copy.about}</a>
  </div>

  <div class="section-head">
    <h2>{t(lang, 'latest')}</h2>
    <a href={url(lang, 'posts/')}>{t(lang, 'allEntries')} ({posts.length}) →</a>
  </div>
  <EntryList lang={lang} posts={posts.slice(0, 6)} showDesc />

  <Fragment slot="aside">
    {now && (
      <section class="note">
        <h2>{t(lang, 'now')}</h2>
        <p>{nowFirst}</p>
        <a class="more" href={url(lang, 'now/')}>{lang === 'zh' ? '看最近在做什麼' : 'What I’m doing now'} →</a>
      </section>
    )}
    <section class="note">
      <h2>{t(lang, 'projects')}</h2>
      <ul>
        {projects.map((p) => <li><a href={url(lang, `projects/${p.slug}/`)}>{p.data.title}</a></li>)}
      </ul>
      <a class="more" href={url(lang, 'projects/')}>{lang === 'zh' ? '全部專案' : 'All projects'} →</a>
    </section>
    <section class="note">
      <h2>{t(lang, 'categories')}</h2>
      <ul>
        {Object.entries(site.categories).map(([key, label]) => {
          const n = posts.filter((p) => p.data.category === key).length;
          return n > 0 && <li><a href={url(lang, `categories/${key}/`)}>{label[lang]}</a> <span class="entry-meta">· {n}</span></li>;
        })}
      </ul>
    </section>
  </Fragment>
</Base>

---
// 文章列表、分類頁、標籤頁共用的版面
import Base from '../layouts/Base.astro';
import EntryList from './EntryList.astro';
import { t, url, type Lang } from '../i18n';
import { tagSlug, postsPagePath, type NumberedPost } from '../lib/content';
import { site } from '../site.config';

interface Props {
  lang: Lang;
  title: string;
  lede: string;
  posts: NumberedPost[];
  allPosts: NumberedPost[];
  pageNo: string;
  currentCategory?: string;
  currentTag?: string;
  altHref: string;
  /** 文章列表的分頁；分類頁、標籤頁不分頁 */
  pager?: { current: number; total: number };
}
const { lang, title, lede, posts, allPosts, pageNo, currentCategory, currentTag, altHref, pager } = Astro.props;
const pageLabel = pager && t(lang, 'pageOf').replace('{n}', String(pager.current)).replace('{total}', String(pager.total));

const tagCounts = new Map<string, { label: string; n: number }>();
for (const p of allPosts) for (const tag of p.data.tags) {
  const k = tagSlug(tag);
  tagCounts.set(k, { label: tag, n: (tagCounts.get(k)?.n ?? 0) + 1 });
}
const tags = [...tagCounts.entries()].sort((a, b) => b[1].n - a[1].n);
---
<Base lang={lang} title={pager && pager.current > 1 ? `${title} · ${pageLabel}` : title} description={lede} pageNo={pageNo} section="writing" altHref={altHref}>
  <h1 class="page-title">{title}{site.placeholder && <span class="sample-tag">{t(lang, 'sample')}</span>}</h1>
  <p class="page-lede">{lede}</p>
  <ul class="filter" aria-label={t(lang, 'categories')}>
    <li><a href={url(lang, 'posts/')} aria-current={!currentCategory && !currentTag ? 'page' : undefined}>{lang === 'zh' ? '全部' : 'All'}<span>{allPosts.length}</span></a></li>
    {Object.entries(site.categories).map(([key, label]) => {
      const n = allPosts.filter((p) => p.data.category === key).length;
      return n > 0 && (
        <li><a href={url(lang, `categories/${key}/`)} aria-current={currentCategory === key ? 'page' : undefined}>{label[lang]}<span>{n}</span></a></li>
      );
    })}
  </ul>
  <div class="section-head"><h2>{pager ? allPosts.length : posts.length} {t(lang, 'entries')}{pager && pager.total > 1 && <span class="list-pager-where"> · {pageLabel}</span>}</h2><a href={url(lang, 'rss.xml')}>{t(lang, 'rss')}</a></div>
  <EntryList lang={lang} posts={posts} showDesc />
  {pager && pager.total > 1 && (
    <nav class="list-pager" aria-label={t(lang, 'pagination')}>
      {pager.current > 1
        ? <a class="list-pager-newer" href={url(lang, postsPagePath(pager.current - 1))} rel="prev">← {t(lang, 'newer')}</a>
        : <span class="list-pager-newer" aria-hidden="true"></span>}
      <ol class="list-pager-pages">
        {Array.from({ length: pager.total }, (_, i) => i + 1).map((n) => (
          <li><a href={url(lang, postsPagePath(n))} aria-current={n === pager.current ? 'page' : undefined}>{n}</a></li>
        ))}
      </ol>
      {pager.current < pager.total
        ? <a class="list-pager-older" href={url(lang, postsPagePath(pager.current + 1))} rel="next">{t(lang, 'older')} →</a>
        : <span class="list-pager-older" aria-hidden="true"></span>}
    </nav>
  )}

  <Fragment slot="aside">
    <section class="note">
      <h2>{t(lang, 'tags')}</h2>
      <ul class="tags">
        {tags.map(([slug, { label, n }]) => (
          <li><a href={url(lang, `tags/${slug}/`)} aria-current={currentTag === slug ? 'page' : undefined}>{label}</a> <span class="entry-meta">{n}</span></li>
        ))}
      </ul>
    </section>
  </Fragment>
</Base>

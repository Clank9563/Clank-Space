---
// 關於、現在、工具這類單頁：內容來自 src/content/pages/<語言>/<名稱>.md
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Toc from './Toc.astro';
import { formatDate, t, url, type Lang } from '../i18n';
import { site } from '../site.config';

interface Props { lang: Lang; name: 'about' | 'now' | 'uses'; pageNo: string }
const { lang, name, pageNo } = Astro.props;
const entry = (await getEntry('pages', `${lang}/${name}`))!;
const { Content, headings } = await render(entry);
---
<Base lang={lang} title={entry.data.title} description={entry.data.description} pageNo={pageNo} section={name} altHref={url(lang === 'zh' ? 'en' : 'zh', `${name}/`)} lastRevised={entry.data.updated} type="article">
  <article class="article">
    <header class="article-head">
      <h1 class="article-title">{entry.data.title}{site.placeholder && <span class="sample-tag">{t(lang, 'sample')}</span>}</h1>
      <p class="article-desc">{entry.data.description}</p>
      <dl class="record">
        <div><dt class="field-label">{t(lang, 'lastRevised')}</dt><dd><time datetime={entry.data.updated.toISOString()}>{formatDate(entry.data.updated, lang)}</time></dd></div>
      </dl>
      <Toc lang={lang} headings={headings} variant="inline" />
    </header>
    <div class="prose" data-pagefind-body>
      <Content />
    </div>
  </article>
  <Fragment slot="aside">
    <Toc lang={lang} headings={headings} />
    <slot name="aside" />
  </Fragment>
</Base>
